{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-functions.mjs",
  "outputDirectory": "public"
}
