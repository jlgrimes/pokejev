# Vercel AI Gateway key — create one at https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Which model is "Jev". Any gateway model id works; list them with: npm run jev -- models
JEV_MODEL=typesafe-ai/jev
# Battles get their own (usually stronger) model. Defaults to JEV_MODEL if unset.
JEV_BATTLE_MODEL=typesafe-ai/jev
# Optional comma-separated gateway fallbacks if the primary model is unavailable.
JEV_FALLBACK_MODELS=

# Send screenshots alongside the text state in the overworld (set to false to save tokens).
JEV_VISION=true
# Hide enemy movesets and exact stats that a human player could not see.
JEV_FAIR_PLAY=false
JEV_TEMPERATURE=0.3
# Playback multiplier, 1-20. Also how sparsely frames are sampled: encoding a
# screenshot costs more than emulating the frame it came from, so a higher
# value makes the game genuinely run faster, not just look faster.
JEV_SPEED=4
# 'evaluate' (default) judges the game state against typed questions, which is
# what an evaluation model like typesafe-ai/jev expects. 'generate' asks a
# language model for a structured object instead.
JEV_MODE=evaluate

# Supply your own legally obtained Pokemon Red ROM.
ROM_PATH=roms/pokemon_red.gb
STATE_PATH=saves/autosave.state.json
JOURNAL_PATH=saves/journal.json

# Viewer port
PORT=8080

# --- Vercel deployment only ---------------------------------------------
# Fetched with `vercel env pull .env` once a Blob store is connected to the
# project. On Vercel the functions authenticate to Blob with the deployment's
# OIDC token plus BLOB_STORE_ID — no read-write token is injected or needed.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
# Optional alternative to the two above, from the Blob store's settings.
BLOB_READ_WRITE_TOKEN=
# Where the ROM lives inside the private Blob store.
ROM_BLOB_KEY=rom/pokemon_red.gb
# Play with heuristics instead of the model (useful for a zero-cost smoke test).
JEV_OFFLINE=false
